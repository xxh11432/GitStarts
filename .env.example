# ===== MySQL =====
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=githubstars
MYSQL_USER=githubstars
MYSQL_PASSWORD=githubstarspass

# ===== Redis =====
REDIS_PASSWORD=redispass

# ===== GitHub =====
# Personal Access Token（用于把 Search API 限流提升到认证档，并提升 REST 到 5000/hr）
GITHUB_TOKEN=

# ===== Backend =====
# 采集开关（本地开发可设 false 关闭定时采集）
SYNC_ENABLED=true

# ===== Frontend =====
# Next.js 服务端渲染时访问后端的内部地址（Docker 内网）
API_INTERNAL_URL=http://backend:8080
