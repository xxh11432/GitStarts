# ===== MySQL =====
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=githubstars
MYSQL_USER=githubstars
MYSQL_PASSWORD=githubstarspass

# ===== Redis =====
REDIS_PASSWORD=redispass

# ===== GitHub =====
# Personal Access Token（用于把 Search API 限流提升到认证档，并提升 REST 到 5000/hr）
GITHUB_TOKEN=

# ===== Backend =====
# 采集开关（本地开发可设 false 关闭定时采集）
SYNC_ENABLED=true

# ===== 账号 / 会话（M1）=====
# GitHub OAuth App：Authorization callback URL 填 http://<host>/api/auth/github/callback
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_REDIRECT_URI=http://localhost/api/auth/github/callback
# 登录成功后回跳的前端地址（浏览器实际访问的站点地址）
APP_FRONTEND_URL=http://localhost
# 生产 HTTPS 环境务必改为 true（本地 HTTP 调试需 false）
SESSION_COOKIE_SECURE=false
# 会话有效期
SESSION_TTL=7d

# ===== Frontend =====
# Next.js 服务端渲染时访问后端的内部地址（Docker 内网）
API_INTERNAL_URL=http://backend:8080

# ===== llm-service（AI 网关）=====
ENVIRONMENT=production
LOG_LEVEL=INFO

# 模型：OpenAI 兼容协议，Key 只注入 llm-service
LLM_BASE_URL=https://api.himodels.ai/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-v4-flash
# 思考模式：auto / enabled / disabled
LLM_THINKING_MODE=disabled

# llm-service 访问 backend 内部接口的地址（Docker 内网）
BACKEND_URL=http://backend:8080

# embedding：fastembed（本地，默认）或 api
# 注意：fastembed 未提供 bge-m3 的 ONNX 版本，本地默认使用 1024 维多语言模型；
# 如需 bge-m3 请设 EMBEDDING_PROVIDER=api 并指定 LLM_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PROVIDER=fastembed
LLM_EMBEDDING_MODEL=intfloat/multilingual-e5-large
LLM_EMBEDDING_DIM=1024

# 镜像构建期是否内置 embedding 模型（默认 false）：
# 容器启动时先检查 model-cache 卷里的缓存，命中则离线加载，缺失才下载一次
PREWARM_MODELS=false

# 服务间鉴权（必填）：用 `openssl rand -hex 32` 生成后填入。
# 留空时 backend 的 /api/internal/** 会全部返回 503，AI 对话 / 匹配 / 对比均不可用。
INTERNAL_TOKEN=

# ===== Qdrant =====
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=repo_chunks

# ===== 语义索引 worker（M4）=====
# 首次启动自动全量建索引，完成后按 INDEX_INTERVAL_MINUTES 跑增量
INDEX_ON_STARTUP=true
INDEX_INTERVAL_MINUTES=60
# 强制重扫所有仓库（README 变更时通常无需开启）
INDEX_FULL_REBUILD=false
# 本地冒烟可限制处理的仓库数，0 表示不限
INDEX_MAX_REPOS=0
INDEX_PAGE_SIZE=100
# 抓取关键 manifest（package.json / pom.xml 等）并作为 manifest 分块入索引
INDEX_MANIFESTS_ENABLED=true
# 仅调试时改，默认 GitHub 官方 API
GITHUB_API_BASE=https://api.github.com

# ===== 语义匹配（M4）=====
MATCH_RECALL_LIMIT=40
MATCH_RERANK_LIMIT=16
MATCH_CACHE_TTL_SECONDS=600

# ===== 深度对比（M5）=====
COMPARE_EVIDENCE_TOPK=6
COMPARE_CACHE_TTL_SECONDS=604800
COMPARE_CHECKPOINT_TTL_SECONDS=3600
COMPARE_TIMEOUT_SECONDS=240

# ===== 配额与并发 =====
QUOTA_CHAT_DAILY=30
QUOTA_COMPARE_DAILY=3
COMPARE_CONCURRENCY=4
WORKER_ENABLED=true
