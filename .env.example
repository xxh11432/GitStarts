# ===== MySQL =====
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=githubstars
MYSQL_USER=githubstars
MYSQL_PASSWORD=githubstarspass

# ===== Redis =====
REDIS_PASSWORD=redispass

# ===== GitHub =====
# Personal Access Token（用于把 Search API 限流提升到认证档，并提升 REST 到 5000/hr）
GITHUB_TOKEN=

# ===== Backend =====
# 采集开关（本地开发可设 false 关闭定时采集）
SYNC_ENABLED=true

# ===== 账号 / 会话（M1）=====
# GitHub OAuth App：Authorization callback URL 填 http://<host>/api/auth/github/callback
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_REDIRECT_URI=http://localhost/api/auth/github/callback
# 登录成功后回跳的前端地址（浏览器实际访问的站点地址）
APP_FRONTEND_URL=http://localhost
# 生产 HTTPS 环境务必改为 true（本地 HTTP 调试需 false）
SESSION_COOKIE_SECURE=false
# 会话有效期
SESSION_TTL=7d

# ===== Frontend =====
# Next.js 服务端渲染时访问后端的内部地址（Docker 内网）
API_INTERNAL_URL=http://backend:8080

# ===== llm-service（AI 网关）=====
ENVIRONMENT=production
LOG_LEVEL=INFO

# 模型：OpenAI 兼容协议，Key 只注入 llm-service
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-ai/DeepSeek-V3

# embedding：fastembed（本地，默认）或 api
# 注意：fastembed 未提供 bge-m3 的 ONNX 版本，本地默认使用 1024 维多语言模型；
# 如需 bge-m3 请设 EMBEDDING_PROVIDER=api 并指定 LLM_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PROVIDER=fastembed
LLM_EMBEDDING_MODEL=intfloat/multilingual-e5-large
LLM_EMBEDDING_DIM=1024

# 镜像构建期是否预热 embedding 模型（首次构建会下载模型，较慢）
PREWARM_MODELS=true

# 服务间鉴权（随机 32 字节，仅 Compose 注入）
INTERNAL_TOKEN=

# ===== Qdrant =====
QDRANT_URL=http://qdrant:6333

# ===== 配额与并发 =====
QUOTA_CHAT_DAILY=30
QUOTA_COMPARE_DAILY=3
COMPARE_CONCURRENCY=4
WORKER_ENABLED=true
