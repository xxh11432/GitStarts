# ===== MySQL =====
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=githubstars
MYSQL_USER=githubstars
MYSQL_PASSWORD=githubstarspass

# ===== Redis =====
REDIS_PASSWORD=redispass
# 内存上限与淘汰策略（volatile-lru 只淘汰带 TTL 的缓存键）
REDIS_MAXMEMORY=64mb

# ===== GitHub =====
# Personal Access Token（用于把 Search API 限流提升到认证档，并提升 REST 到 5000/hr）
GITHUB_TOKEN=

# ===== Backend =====
# 采集开关（本地开发可设 false 关闭定时采集）
SYNC_ENABLED=true
# 仓库总量目标：分层发现按「高星 > 近期活跃 > 近期热点 > 语言补齐」多趟拉取并去重
SYNC_MAX_REPOS=2000
# 每小时增量刷新的仓库数（2000 条约 10 小时轮完一遍）
SYNC_INCREMENTAL_BATCH=200
# 近 N 天有推送视为活跃
SYNC_ACTIVE_DAYS=90
# 语言补齐每种语言的上限
SYNC_LANGUAGE_BATCH=100
# 每日 Release 刷新上限
SYNC_RELEASE_REFRESH=2000

# ===== 账号 / 会话（M1）=====
# GitHub OAuth App：Authorization callback URL 填 http://<host>/api/auth/github/callback
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_REDIRECT_URI=http://localhost/api/auth/github/callback
# 登录成功后回跳的前端地址（浏览器实际访问的站点地址）
APP_FRONTEND_URL=http://localhost
# 生产 HTTPS 环境务必改为 true（本地 HTTP 调试需 false）
# HTTPS 站点若仍为 false，backend 会在启动期直接失败（StartupSecurityCheck）
SESSION_COOKIE_SECURE=false
# 会话有效期
SESSION_TTL=7d

# ===== Frontend =====
# Next.js 服务端渲染时访问后端的内部地址（Docker 内网）
API_INTERNAL_URL=http://backend:8080

# ===== llm-service（AI 网关）=====
ENVIRONMENT=production
LOG_LEVEL=INFO

# 模型：OpenAI 兼容协议，Key 只注入 llm-service
LLM_BASE_URL=https://api.himodels.ai/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-v4-flash
# 思考模式：auto / enabled / disabled
LLM_THINKING_MODE=disabled

# llm-service 访问 backend 内部接口的地址（Docker 内网）
BACKEND_URL=http://backend:8080

# embedding：默认调用硅基流动（SiliconFlow）OpenAI 兼容接口，进程内不加载本地模型
# Key 获取：https://cloud.siliconflow.cn/account/ak
EMBEDDING_PROVIDER=api
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=BAAI/bge-m3
LLM_EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# 离线备用：fastembed 本地模型（EMBEDDING_PROVIDER=fastembed 时生效）
# 构建期不下载模型，启动时复用 model-cache 卷缓存
PREWARM_MODELS=false

# 服务间鉴权（必填）：用 `openssl rand -hex 32` 生成后填入。
# 留空时 backend 的 /api/internal/** 会全部返回 503，AI 对话 / 匹配 / 对比均不可用。
INTERNAL_TOKEN=

# ===== Qdrant =====
QDRANT_URL=http://qdrant:6333
# 更换 embedding 模型后换新集合名，worker 会按集合名自动触发一次全量重建
QDRANT_COLLECTION=repo_chunks_bge_m3
# 低内存部署：向量与 HNSW 落盘（mmap）
QDRANT_ON_DISK=true

# ===== 语义索引 worker（M4）=====
# 首次启动自动全量建索引，完成后按 INDEX_INTERVAL_MINUTES 跑增量
INDEX_ON_STARTUP=true
INDEX_INTERVAL_MINUTES=60
# 强制重扫所有仓库（README 变更时通常无需开启）
INDEX_FULL_REBUILD=false
# 本地冒烟可限制处理的仓库数，0 表示不限
INDEX_MAX_REPOS=0
INDEX_PAGE_SIZE=100
# 抓取关键 manifest（package.json / pom.xml 等）并作为 manifest 分块入索引
INDEX_MANIFESTS_ENABLED=true
# 仅调试时改，默认 GitHub 官方 API
GITHUB_API_BASE=https://api.github.com
# SSRF 白名单：只允许向这些主机抓取 README / manifest，逗号分隔（GitHub Enterprise 需同步加入）
GITHUB_ALLOWED_HOSTS=api.github.com
# worker 与 backend 共享同一 GitHub Token 配额；0 表示不限速
GITHUB_REQUESTS_PER_MINUTE=60

# ===== 语义匹配（M4）=====
MATCH_RECALL_LIMIT=40
MATCH_RERANK_LIMIT=8
MATCH_CACHE_TTL_SECONDS=600

# ===== 深度对比（M5）=====
COMPARE_EVIDENCE_TOPK=6
COMPARE_CACHE_TTL_SECONDS=604800
COMPARE_CHECKPOINT_TTL_SECONDS=3600
COMPARE_TIMEOUT_SECONDS=240

# ===== 配额与并发 =====
QUOTA_CHAT_DAILY=30
QUOTA_COMPARE_DAILY=3
COMPARE_CONCURRENCY=4
WORKER_ENABLED=true

# ===== 成本看板（M7）=====
# 可访问 /ops 的 GitHub 登录名，逗号分隔；留空时全部拒绝
OPS_GITHUB_LOGINS=
# 预算阈值：日 token、日对比次数、P95 延迟（毫秒）。越界会写入 ops_alert 日志并在 /ops 标红
OPS_DAILY_TOKEN_BUDGET=2000000
OPS_DAILY_COMPARE_BUDGET=200
OPS_P95_CHAT_MS=30000
OPS_P95_MATCH_MS=30000
OPS_P95_COMPARE_MS=180000
# ai_metrics 自动清理保留天数；0 表示关闭自动清理
OPS_METRICS_RETENTION_DAYS=180

# ===== 资源上限（可选，默认值针对 2 GB 内存机器） =====
# MYSQL_MEM_LIMIT=320m / REDIS_MEM_LIMIT=96m / QDRANT_MEM_LIMIT=320m
# BACKEND_MEM_LIMIT=448m / LLM_MEM_LIMIT=256m / WORKER_MEM_LIMIT=288m
# FRONTEND_MEM_LIMIT=192m / NGINX_MEM_LIMIT=32m
# MySQL buffer pool 默认 64M，可单独调大：MYSQL_BUFFER_POOL_SIZE=64M
# embedding 走 API 后 LLM_MEM_LIMIT / WORKER_MEM_LIMIT 不再受模型常驻内存影响
